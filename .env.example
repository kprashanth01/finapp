# Copy to .env in the repository root and fill in your local database URL.
DATABASE_URL=
# Optional. Only used when someone presses Generate explanation.
OPENAI_API_KEY=
# Optional model override; default is gpt-4o-mini.
# FINAPP_LLM_MODEL=gpt-4o-mini
# Optional local Advisor chat model. Install it with: ollama pull qwen3.5:4b
# FINAPP_CHAT_MODEL=qwen3.5:4b
# Optional default for the Advisor's experimental agent selector only.
# Saved monthly plans still use the complete rule-based coordinator.
# ORCHESTRATOR_MODE=rule_based
# Optional explicit browser origins when the frontend is not on a default local Vite origin.
# FINAPP_ALLOWED_ORIGINS=http://127.0.0.1:5173
